<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Color Primitives -->
    <Color x:Key="CanvasColor">#0B0A10</Color>
    <Color x:Key="SurfaceColor">#15121E</Color>
    <Color x:Key="SurfaceGlassColor">#E815121E</Color>
    <Color x:Key="SurfaceElevatedColor">#1D1929</Color>
    <Color x:Key="SurfaceElevatedGlassColor">#D91D1929</Color>
    <Color x:Key="SurfaceHoverColor">#29223A</Color>
    <Color x:Key="SurfacePressedColor">#362C4E</Color>

    <!-- Accents -->
    <Color x:Key="AccentColor">#A879FF</Color>
    <Color x:Key="AccentSoftColor">#C7A7FF</Color>
    <Color x:Key="AccentDeepColor">#7045B8</Color>
    <Color x:Key="AccentGlowColor">#55A879FF</Color>
    <Color x:Key="AccentGlowSoftColor">#22A879FF</Color>

    <!-- Typography -->
    <Color x:Key="TextPrimaryColor">#F7F3FF</Color>
    <Color x:Key="TextSecondaryColor">#B3AABD</Color>
    <Color x:Key="TextMutedColor">#81788D</Color>

    <!-- Borders -->
    <Color x:Key="BorderSubtleColor">#2E2542</Color>
    <Color x:Key="BorderMediumColor">#483A63</Color>
    <Color x:Key="BorderGlowingColor">#7A54BD</Color>

    <!-- Status Indicators (Demo Only) -->
    <Color x:Key="SuccessColor">#45D69A</Color>
    <Color x:Key="WarningColor">#F2B96F</Color>
    <Color x:Key="DangerColor">#FF6B83</Color>

    <!-- Solid Brushes -->
    <SolidColorBrush x:Key="CanvasBrush" Color="{StaticResource CanvasColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceGlassBrush" Color="{StaticResource SurfaceGlassColor}" />
    <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="{StaticResource SurfaceElevatedColor}" />
    <SolidColorBrush x:Key="SurfaceElevatedGlassBrush" Color="{StaticResource SurfaceElevatedGlassColor}" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}" />
    <SolidColorBrush x:Key="SurfacePressedBrush" Color="{StaticResource SurfacePressedColor}" />

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />
    <SolidColorBrush x:Key="AccentDeepBrush" Color="{StaticResource AccentDeepColor}" />
    <SolidColorBrush x:Key="AccentGlowBrush" Color="{StaticResource AccentGlowColor}" />
    <SolidColorBrush x:Key="AccentGlowSoftBrush" Color="{StaticResource AccentGlowSoftColor}" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />

    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtleColor}" />
    <SolidColorBrush x:Key="BorderMediumBrush" Color="{StaticResource BorderMediumColor}" />
    <SolidColorBrush x:Key="BorderGlowingBrush" Color="{StaticResource BorderGlowingColor}" />

    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />

    <!-- Gradient Brushes -->
    <LinearGradientBrush x:Key="GlassBorderGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#8561C8" Offset="0.0" />
        <GradientStop Color="#3D3055" Offset="0.5" />
        <GradientStop Color="#5A408E" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PlayButtonGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#352656" Offset="0" />
        <GradientStop Color="#23173E" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ProgressGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#8453D8" Offset="0" />
        <GradientStop Color="#A879FF" Offset="0.8" />
        <GradientStop Color="#C7A7FF" Offset="1" />
    </LinearGradientBrush>

</ResourceDictionary>
